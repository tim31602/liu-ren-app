import React, { useState, useEffect } from "react";

const sixSpirits = ["大安", "留連", "速喜", "赤口", "小吉", "空亡"];

const spiritMeanings = {
  大安: "平穩、吉利，凡事可成，適合出行、安居。",
  留連: "拖延不決，事情反覆，適合等待，不宜急進。",
  速喜: "喜事臨門，有貴人助，適合婚姻、出行、求財。",
  赤口: "口舌是非、爭執、官司，不利出行。",
  小吉: "小有收穫，事情能成，但力量有限。",
  空亡: "落空、失敗，事情難成，不宜冒險。"
};

const calcLiuRen = (date) => {
  const month = date.getMonth() + 1;
  const day = date.getDate();
  const hour = date.getHours();
  let index = (month - 1) % 6;
  index = (index + (day - 1)) % 6;
  const shichen = Math.floor((hour + 1) / 2) % 12;
  index = (index + shichen) % 6;
  return sixSpirits[index];
};

export default function App() {
  const [result, setResult] = useState(null);
  const [startTime, setStartTime] = useState(null);
  const [now, setNow] = useState(new Date());

  useEffect(() => {
    const timer = setInterval(() => setNow(new Date()), 1000);
    return () => clearInterval(timer);
  }, []);

  const handleClick = () => {
    const spirit = calcLiuRen(now);
    setResult(spirit);
    setStartTime(new Date(now));
  };

  const handleReset = () => {
    setResult(null);
    setStartTime(null);
  };

  return (
    <div
      className="flex flex-col items-center min-h-screen bg-cover bg-center p-6"
      style={{
        backgroundImage: "url('/Y_S06571.jpg')",
        backgroundSize: "cover",
        backgroundPosition: "center",
      }}
    >
      <div className="bg-white/80 rounded-3xl p-6 shadow-lg text-center max-w-md">
        <h1 className="text-3xl font-bold text-amber-800 mb-2">小六壬卜卦</h1>
        <p className="text-gray-700">
          現在時間：{now.toLocaleString("zh-TW")}
        </p>

        {startTime && (
          <p className="text-gray-700 mb-4">
            起課時間：{startTime.toLocaleString("zh-TW")}
          </p>
        )}

        {!result ? (
          <button
            onClick={handleClick}
            className="mt-4 px-6 py-3 bg-amber-600 text-white rounded-2xl shadow-lg hover:bg-amber-700 transition"
          >
            起課
          </button>
        ) : (
          <>
            <div className="mt-6 bg-white rounded-2xl shadow-lg p-6">
              <h2 className="text-2xl font-semibold text-amber-700 mb-3">
                {result}
              </h2>
              <p className="text-gray-700">{spiritMeanings[result]}</p>
            </div>
            <button
              onClick={handleReset}
              className="mt-6 px-5 py-2 bg-amber-500 text-white rounded-xl hover:bg-amber-600 transition"
            >
              重新卜卦
            </button>
          </>
        )}
      </div>
    </div>
  );
}
